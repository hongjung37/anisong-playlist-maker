# ============================================
# AniTune MVP — Environment Variables
# ============================================
# Copy this file to `.env.local` and fill in the keys you want to use.

# 1. Gemini API (Required for live AI playlist curation)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. YouTube Data API & Google OAuth 2.0 (For YouTube / YouTube Music playlist export)
# Create OAuth 2.0 Client ID (Web application) in Google Cloud Console:
# Authorized redirect URI: http://localhost:3000/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: API key for unauthenticated YouTube preview resolution during generation
YOUTUBE_API_KEY=

# 3. Spotify OAuth 2.0 (For Spotify playlist export)
# Create an app in Spotify Developer Dashboard:
# Redirect URI: http://127.0.0.1:3000/api/auth/spotify/callback (or http://localhost:3000/api/auth/spotify/callback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 4. App Origin & Session Signing Secret
# Used to build OAuth redirect URIs cleanly and sign session cookies.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_COOKIE_SECRET=replace-with-a-random-32-char-secret
